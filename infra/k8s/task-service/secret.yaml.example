# Copy this file to secret.yaml and fill in real values before applying.
# secret.yaml is gitignored (infra/k8s/**/secret.yaml) — it is never committed.
apiVersion: v1
kind: Secret
metadata:
  name: task-service-secrets
type: Opaque
stringData: # stringData accepts plain text, Kubernetes base64-encodes it on write
  DB_USER: "CHANGE_ME"
  DB_PASSWORD: "CHANGE_ME"
